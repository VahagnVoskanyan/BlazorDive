@page "/todolist"

@rendermode InteractiveServer

<h3>To Do List</h3>
<br />
<br />

<button type="button"
        class="btn btn-primary"
        @onclick="AddTask">
    Add Task
</button>
<br />
<br />

@if (_items != null && _items.Count > 0)
{
    <ul class="list-unstyled">
        <ItemsListComponent Items="_items"></ItemsListComponent>
    </ul>
}

@code {
    private List<ToDoItem> _items = ToDoItemsRepo.GetItems();

    private void AddTask()
    {
        ToDoItemsRepo.AddItem(new ToDoItem { Name = "New Task" });
        _items = ToDoItemsRepo.GetItems();
    }
}
