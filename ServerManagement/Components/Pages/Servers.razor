@page "/servers"
@page "/servers/back_from/{CityName}"

@using ServerManagement.Components.Controls
@using ServerManagement.StateStore

@* For Server Interactivy *@
@rendermode InteractiveServer

@inject NavigationManager NaviMan
@inject TorontoOnlineServersStore TorontoOnlineServersStore

<h3>Servers</h3>
<br />
<br />

<CityListComponent @ref="cityListComponent" 
    SelectedCityCallback="HandleCitySelection"
    SelectedCity="@selectedCity"></CityListComponent>

<br />

<SearchBarComponent @ref="searchBarComponent" 
    SearchServersCallback="HandleSearchServer"
    style="width:500px">
</SearchBarComponent>

<br />

@* Cascading Parameter *@
<CascadingValue Name="SelectedCity" Value="@selectedCity">
    @* For Server Interactivy *@
    <ServerListComponent @rendermode="InteractiveServer"
                         CityName=@selectedCity
                         SearchFilter=@searchFilter></ServerListComponent>
</CascadingValue>
<p>
    @* <a href="/servers/add" class="btn btn-primary">Add Server</a> *@
    @* Using Combined AddEdit Server *@
    <a href="/server" class="btn btn-primary">Add Server</a>
</p>

<p>
    <button class="btn btn-secondary"
            @onclick="@(() =>
                    {
                        //this.servers.Insert(0, new Server {Name = "ServerA", City = "Toronto" });
                    })">
        Add Server 2
    </button>
</p>

@code {
    [Parameter]
    public string? CityName { get; set; }

    private string selectedCity = "Toronto";
    private string searchFilter = "";

    private CityListComponent? cityListComponent;
    private SearchBarComponent? searchBarComponent;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (RendererInfo.IsInteractive)
        {
            var serversToronto = ServersRepository.GetServersByCity("Toronto");
            TorontoOnlineServersStore.SetNumberServersOnline(serversToronto.Count(s => s.IsOnline));
        }
    }

    private void HandleCitySelection(string cityName)
    {
        this.selectedCity = cityName;
        this.searchFilter = "";

        searchBarComponent?.ClearSearch();
    }

    private void HandleSearchServer(string seacrhFilter)
    {
        this.searchFilter = seacrhFilter;

        cityListComponent?.ClearSelectedCity();
    }

    protected override void OnParametersSet()
    {
        if (NaviMan.Uri.Contains("back_from") &&
                !string.IsNullOrEmpty(CityName))
        {
            selectedCity = CityName;
        }
    }

    /*private void HandleServerFilterChange(ChangeEventArgs args)
    {
        serverFilter = args.Value?.ToString() ?? string.Empty;
    }*/
}
