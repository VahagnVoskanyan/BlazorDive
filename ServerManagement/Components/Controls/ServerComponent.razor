@code {
    // Using routable component as non-routable component example
    // private bool editingServer = false;

    [CascadingParameter(Name = "SelectedCity")]
    public string? SelectedCity { get; set; }

    [Parameter]
    public Server? Server { get; set; }


    # region For Controlling the rendering of the component.

    private string? prevServerName;
    private string? prevServerCity;
    private bool? prevIsOnline;
    private bool shouldRender;
    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        shouldRender =
            prevServerName != Server?.Name ||
            prevServerCity != Server?.City ||
            prevIsOnline != Server?.IsOnline;

        if (shouldRender)
        {
            prevServerName = Server?.Name;
            prevServerCity = Server?.City;
            prevIsOnline = Server?.IsOnline;
        }
    }
    protected override bool ShouldRender()
    {
        Console.WriteLine("ServerComponent ShouldRender called.");
        // To Test Random Number Generation using Timer
        //return true;
        return shouldRender;
    }

    #endregion

    private void DeleteServer(int serverId)
    {
        if (serverId > 0)
        {
            ServersRepository.DeleteServer(serverId);
            NaviMan.NavigateTo("/servers", true);
        }
    }

    private string GetBackgroundColor()
    {
        if (SelectedCity != null && Server != null && Server.City == SelectedCity)
        {
            switch (SelectedCity)
            {
                case "Toronto":
                    return "powderblue";
                case "Ottawa":
                    return "pink";
                case "Montreal":
                    return "white";
                case "Calgary":
                    return "palegreen";
                case "Halifax":
                    return "lightgray";
                default:
                    return "white"; // Default background for other cities
            }
        }
        return "white"; // Default background for other servers
    }


